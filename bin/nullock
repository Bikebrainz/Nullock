    local host=$1; shift
    local ports="[]"
    if [[ -n ${1-} ]]; then
        ports="["; local first=1
        local IFS=','; for p in $1; do
            if (( first )); then first=0; else ports+=","; fi
            ports+="$p"
        done
        ports+="]"
    fi
    post /api/servicevulns/scan "{\"host\":$(jsonq "$host"),\"ports\":$ports}" | pp
}

