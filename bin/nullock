cmd_idor() {
    # nullock idor <url> [idParam] [Header:Value ...]
    # Tests for horizontal IDOR by replaying neighboring object ids.
    [[ -n ${1-} ]] || die "usage: nullock idor <url> [idParam] [Header:Value ...]"
    local url=$1; shift
    local idParam=""
    # First arg may be an idParam (no colon) or a header (has colon).
    if [[ -n ${1-} && $1 != *:* ]]; then idParam=$1; shift; fi
    local headers="{}"
    if (( $# > 0 )); then
        headers="{"; local first=1
        for h in "$@"; do
            local name=${h%%:*} val=${h#*:}; val=${val# }
            if (( first )); then first=0; else headers+=","; fi
            headers+="$(jsonq "$name"):$(jsonq "$val")"
        done
        headers+="}"
    fi
    local body="{\"url\":$(jsonq "$url"),\"headers\":$headers"
    [[ -n $idParam ]] && body+=",\"idParam\":$(jsonq "$idParam")"
    body+="}"
    post /api/idor/test "$body" | pp
}

cmd_paramminer() {
    # nullock paramminer <url> [method] [wordlist-file]
    [[ -n ${1-} ]] || die "usage: nullock paramminer <url> [GET|POST] [wordlist-file]"
    local url=$1 method=${2:-GET} body
    if [[ -n ${3-} ]]; then
        local words
        words=$(grep -v '^[[:space:]]*$' "$3" | "$JQ" -R . | "$JQ" -s -c .)
        body="{\"url\":$(jsonq "$url"),\"method\":$(jsonq "$method"),\"wordlist\":$words}"
    else
        body="{\"url\":$(jsonq "$url"),\"method\":$(jsonq "$method")}"
    fi
    post /api/paramminer "$body" | pp
}

cmd_jwt() {
    # nullock jwt analyze <token> [wordlist-file]
    # nullock jwt forge   <token> none|hs256 [secret] [claim=val ...]
    case ${1:-} in
        analyze)
            [[ -n ${2-} ]] || die "usage: nullock jwt analyze <token> [wordlist-file]"
            local token=$2 body
            if [[ -n ${3-} ]]; then
                # Build a JSON array of words from the wordlist file.
                local words
                words=$(while IFS= read -r line; do
                            [[ -z $line ]] && continue
                            printf '%s\n' "$line"
                        done < "$3" | "$JQ" -R . | "$JQ" -s -c .)
                body="{\"token\":$(jsonq "$token"),\"wordlist\":$words}"
            else
                body="{\"token\":$(jsonq "$token")}"
            fi
            post /api/jwt/analyze "$body" | pp
            ;;
        forge)
            [[ $# -ge 3 ]] || die "usage: nullock jwt forge <token> none|hs256 [secret] [claim=val ...]"
            local token=$2 attack=$3 secret=${4:-}
            shift 4 2>/dev/null || shift $#
            # Remaining args claim=val become a JSON claims object.
            local claims="{}"
            if (( $# > 0 )); then
                claims="{"
                local first=1
                for kv in "$@"; do
                    local k=${kv%%=*} v=${kv#*=}
                    if (( first )); then first=0; else claims+=","; fi
                    claims+="$(jsonq "$k"):$(jsonq "$v")"
                done
                claims+="}"
            fi
            local body="{\"token\":$(jsonq "$token"),\"attack\":$(jsonq "$attack"),\"claims\":$claims"
            [[ -n $secret ]] && body+=",\"secret\":$(jsonq "$secret")"
            body+="}"
            post /api/jwt/forge "$body" | pp
            ;;
        *) die "usage: nullock jwt {analyze <token> [wordlist]|forge <token> none|hs256 [secret] [claim=val ...]}" ;;
    esac
}

cmd_chain() {
    # nullock chain <chain-file.json | ->
    # Runs a multi-step request chain. The file is the JSON body the
    # /api/chain/run endpoint expects: { steps: [...], continueOnError? }.
    [[ -n ${1-} ]] || die "usage: nullock chain <chain-file.json|->"
    local doc
    if [[ $1 == "-" ]]; then doc=$(cat); else doc=$(cat "$1"); fi
    # Pass through verbatim -- the file already is the request body.
    curl -sS --max-time 120 \
         -H "Content-Type: application/json" \
         -H "Origin: $API" \
         -H "X-Nullock-UI: 1" \
         -X POST -d "$doc" \
         "$API/api/chain/run" | pp
}

cmd_graphql() {
    # nullock graphql <url> [header:value ...]
    # Fires 5 GraphQL active probes against the target.
    [[ -n ${1-} ]] || die "usage: nullock graphql <url> [Header:Value ...]"
    local url=$1; shift
    local headers="{}"
    if (( $# > 0 )); then
        headers="{"
        local first=1
        for h in "$@"; do
            local name=${h%%:*}
            local val=${h#*:}
            val=${val# }
            if (( first )); then first=0; else headers+=","; fi
            headers+="$(jsonq "$name"):$(jsonq "$val")"
        done
        headers+="}"
    fi
    # First arg "schema" -> schema analysis instead of the probe battery.
    if [[ $url == "schema" ]]; then
        local surl=$1; shift 2>/dev/null || true
        # rebuild headers from remaining args
        headers="{}"
        if (( $# > 0 )); then
            headers="{"; local first=1
            for h in "$@"; do
                local name=${h%%:*} val=${h#*:}; val=${val# }
                if (( first )); then first=0; else headers+=","; fi
                headers+="$(jsonq "$name"):$(jsonq "$val")"
            done
            headers+="}"
        fi
        post /api/graphql/schema "{\"url\":$(jsonq "$surl"),\"headers\":$headers}" | pp
        return
    fi
    post /api/graphql/probe \
        "{\"url\":$(jsonq "$url"),\"headers\":$headers}" | pp
}

cmd_cve() {
    # Just findings filtered to the cve-correlated kind so the CVE
    # tags are surfaced cleanly.
    curl -sS --max-time 5 "$API/api/snapshot" \
        | "$JQ" '[.findings[] | select(.kind=="cve-correlated") | {
              cve: (.summary | split(":") | .[0]),
              severity, summary, url, evidence,
              cvss: .cvssScore, vector: .cvssVector,
              compliance: .compliance, fix: .fixSummary
          }]'
}

cmd_help() {
    cat <<EOF
nullock -- CLI for a running Nullock instance

Targets \$NULLOCK_API (default $API).
Requires curl + jq.

Status / inspection:
  nullock status                 quick summary (proxy / project / counts)
  nullock history [N]            last N captured rows (default 20)
  nullock history-show <id>      raw request + response for row <id>
  nullock findings [severity]    findings list (filter: high|medium|low|info)

Scanning:
  nullock scan <target> [preset] target = host / CIDR (1.2.3.0/24) / a,b,c
                                 preset = discovery|top100|web|full1024
                                 (default top100)
  nullock recon <domain>         DNS + small wordlist subdomain enum
  nullock probe-all [throttleMs] active probe across every row with params
  nullock replay <row-id>        re-fire row through proxy + mutations

Mutation:
  nullock rule add <name> <section> <find> <replace>
                                 section: 0=URL 1=req-header 2=req-body
                                          3=resp-header 4=resp-body 5=resp-status
  nullock rule list
  nullock rule clear

Intercept:
  nullock intercept toggle|forward|drop|queue

Repeater:
  nullock repeater set <host> <port> <tls> [request-file|-]
                                 load a request to fire (file or stdin)
  nullock repeater send          fire the active tab + return status + body preview
  nullock repeater show          inspect the loaded request
  nullock repeater response      raw response body from the last send
  nullock repeater load <row-id> add a captured row as a fresh tab
  nullock repeater clear         clear the active tab
  nullock repeater tabs          list tabs with active marker
  nullock repeater tab add [name]
  nullock repeater tab close <index>
  nullock repeater tab activate <index>
  nullock repeater tab rename <index> <name>
  nullock repeater tab duplicate <index>

Intruder:
  nullock intruder set <host> <port> <tls> [template-file|-] [payloads-file|-]
                                 payloads = one per line; \xC2\xA7marker\xC2\xA7 in template
  nullock intruder start         fire the attack (returns immediately)
  nullock intruder stop          interrupt a running attack
  nullock intruder clear         drop results + loaded state
  nullock intruder status        running flag, payload count, result count
  nullock intruder results [status]
                                 list results, optionally filtered by status code
  nullock intruder resend <row>  re-fire one result row

Project:
  nullock project list
  nullock project open <name>
  nullock project create <name>
  nullock project templates                  list pre-built engagement templates
  nullock project from-template <id> <name>  create from template
  nullock project clear-history

Report:
  nullock report build [output.md]           markdown engagement report

Update:
  nullock update                             check if newer release on GitHub

WebSocket Repeater:
  nullock ws sessions                    list active WS tunnels
  nullock ws send <id> <up|down> <opcode> [payload]
                                         inject a frame into a live tunnel
                                         opcode: 1=text, 2=binary, 8=close,
                                         9=ping, 10=pong

OAST (out-of-band callback sink + auto-correlation):
  nullock oast mint                      get a fresh token + URL to embed
  nullock oast mint <host> [param] [note]
                                         mint a *registered* token -- when the
                                         callback lands, a confirmed SSRF
                                         finding auto-appears (Collaborator-style,
                                         self-hosted). Paste pathUrl into a request.
  nullock oast blast <url>               spray OOB payloads (SSRF param battery
                                         + blind XXE) at one target; callbacks
                                         auto-confirm tagged by attack class
  nullock oast poll [since-id]           list hits since the given id
  nullock oast status                    running/port/host/hits + registered/confirmed
  nullock oast watch                     tail mode -- prints new hits live

Session handling rules:
  nullock session-rules set <file.json>  load a JSON array of SessionRule
  nullock session-rules list             current rules + variable bag
  nullock session-rules clear-vars       drop the variable bag

Crawler:
  nullock crawler start <url> [pages] [depth] [throttleMs]
  nullock crawler stop
  nullock crawler status

OpenAPI:
  nullock openapi import <spec.json> [base-url]
                                         walks paths/methods, emits one
                                         captured row per operation
  nullock openapi export                 reverse: capture history -> OpenAPI 3.1

HTTP/2 native:
  nullock h2 streams                     all captured h2 streams + status
  nullock h2 events [since-ms]           raw frame-level events
  nullock h2 watch                       live frame tail

Cookies:
  nullock cookies                        per-host inventory + security score

Triage:
  nullock triage <rowId> [kind] [sev] [summary] [evidence]
                                         AI triage via local Ollama

Extensions:
  nullock extensions install-builtins    copy aws_sigv4.js / identity_rotate.js
                                         to your extensions dir
  nullock extensions reload              reload all extensions from disk

Export:
  nullock export nmap | sarif | postman | har

Sequencer (token randomness analyzer):
  nullock sequencer <token1> [token2 ...]
                                         Shannon entropy + verdict per token

Above-Burp features (v4/v5):
  nullock payloads <kind> [count]        AI-generated payloads via local Ollama
                                         kinds: xss|sqli|ssti|cmd|lfi|xxe|...
  nullock authz <row> <c1> <c2> [...]    multi-user replay; flags rows where
                                         all users see the same status+length
                                         (privilege escalation indicator)
  nullock grouped                        findings grouped + deduped (Burp issue
                                         activity equivalent)
  nullock cve                            findings filtered to CVE-correlated,
                                         with CVE id / CVSS / fix version
  nullock graphql <url> [hdr:val ...]    5 active GraphQL probes (introspection,
                                         field suggestion, alias amplification,
                                         depth bypass, batched-query bypass)
  nullock graphql schema <url> [hdr:val ...]
                                         analyze the GraphQL schema (if
                                         introspection is on): flags dangerous
                                         mutations + sensitive fields
  nullock chain <file.json|->            run a multi-step request chain;
                                         extract vars from each response (json/
                                         header/cookie/regex/status) and thread
                                         them as {{var}} into later requests
  nullock jwt analyze <token> [wordlist] decode + flag weaknesses (alg:none,
                                         no/expired exp, weak HMAC, priv claims,
                                         kid injection); wordlist brute-forces
                                         the HS* secret
  nullock jwt forge <token> none|hs256 [secret] [claim=val ...]
                                         forge alg:none (signature stripped) or
                                         re-sign HS256 with secret, applying any
                                         claim overrides (e.g. admin=true)
  nullock paramminer <url> [GET|POST] [wordlist]
                                         discover hidden params -- response-diffs
                                         a candidate wordlist, reports the ones
                                         reflected or that flip the HTTP status
  nullock idor <url> [idParam] [hdr:val ...]
                                         IDOR/BOLA test -- replays neighboring
                                         object ids under your session; reports
                                         ids that return distinct valid objects
  nullock massassign <url> [POST|PUT|PATCH] [body-file|-] [hdr:val ...]
                                         mass-assignment test -- injects
                                         privileged fields (role, is_admin,
                                         balance...) into the write request and
                                         reports the ones the server accepts
  nullock cors <url> [hdr:val ...]       active CORS test -- fires an Origin
                                         battery (arbitrary, null, subdomain,
                                         scheme-swap) and flags which reflect,
                                         with/without credentials
  nullock jsrecon <url> [hdr:val ...]    mine same-origin JS bundles for API
                                         endpoints (attack surface) + flag
                                         exposed source maps (leak source)
  nullock race <url> [count] [method] [body-file|-] [hdr:val ...]
                                         race-condition test -- fires N
                                         concurrent copies; flags a single-use
                                         operation that leaked extra successes
  nullock verbtamper <url> [method] [hdr:val ...]
                                         method auth-bypass -- retries a denied
                                         request with alternate verbs / override
                                         headers; flags any that flip to 2xx
  nullock ssti <url> <param> [query|form|json] [method] [hdr:val ...]
                                         server-side template injection -- injects
                                         an arithmetic polyglot per engine family
                                         and confirms when the product is rendered
  nullock cachepoison <url> [hdr:val ...]
                                         web cache poisoning -- reflects unkeyed
                                         headers behind a cache-buster and proves
                                         a clean request is served the poison
  nullock openredirect <url> [param] [hdr:val ...]
                                         open redirect -- fires parser-confusion
                                         bypass payloads and confirms by the
                                         resolved Location host (no reflection FP)
  nullock headeraudit <url> [hdr:val ...]
                                         security-header + CSP audit -- flags
                                         unsafe-inline/eval, wildcard sources,
                                         bypassable gadget hosts, HSTS, cookies
  nullock secrets <url> [hdr:val ...]    scan the page + same-origin JS for
                                         exposed keys/tokens/private keys
                                         (AWS, Google, Stripe, GitHub...), masked
  nullock crlf <url> [param] [hdr:val ...]
                                         CRLF / response splitting -- injects
                                         encoded CRLF + a marker header and
                                         confirms it lands in the response
  nullock lfi <url> [param] [hdr:val ...]
                                         path traversal / LFI -- traversal
                                         encodings to /etc/passwd & win.ini,
                                         confirmed by file content signature
  nullock cmdi <url> [param] [hdr:val ...]
                                         OS command injection -- chains echo
                                         $((a*b)); confirmed RCE when the shell
                                         evaluates the arithmetic (no timing)
  nullock xss <url> [param] [hdr:val ...]
                                         reflected XSS -- marker tag, confirmed
                                         only when it reflects unencoded in
                                         executable HTML element content
  nullock sqli <url> [param] [blind] [hdr:val ...]
                                         SQL injection -- error-based (DBMS error
                                         the baseline lacks, cleared when balanced);
                                         add 'blind' for time-based SLEEP detection
  nullock xxe <url> [hdr:val ...]        XXE -- POSTs an XML body whose external
                                         entity reads a local file; confirmed by
                                         the file's content signature
  nullock nosqli <url> [param] [hdr:val ...]
                                         NoSQL operator injection -- literal vs
                                         $ne vs $eq differential confirms a query
                                         operator was interpreted (auth bypass)
  nullock smuggle <url> [hdr:val ...]    HTTP request smuggling -- times CL.TE /
                                         TE.CL desync probes; flags a variant
                                         whose response is reproducibly delayed
                                         (slow: blocks until back-end timeout)
  nullock vulnscan <host> [p,p,...]      service-version CVE match -- banner-grabs
                                         network services (SSH/FTP/SMTP/HTTP...) and
                                         flags vulnerable versions (vsftpd, OpenSSH,
                                         Apache, ProFTPd, Exim, IIS, Samba...)
  nullock tls <host> [port]              TLS/cert inspection -- flags expired,
                                         self-signed, weak-key, hostname-mismatch
                                         certs + deprecated TLS 1.0/1.1
  nullock fingerprint <url>              active tech detection -- server/CMS/
                                         framework/JS-lib + version from headers,
                                         cookies, body; CVE-correlates versions
  nullock methods <url>                  HTTP method audit -- flags dangerous
                                         write/WebDAV methods + TRACE/XST (read-only)
  nullock takeover <host>                subdomain-takeover -- matches dangling
                                         service fingerprints (GitHub Pages, S3,
                                         Heroku, Azure, Fastly, Shopify...)
  nullock assess <url>                   one-call host assessment -- tech
                                         fingerprint+CVE, header/CSP audit, HTTP
                                         method audit, TLS inspect; aggregated
  nullock exposure <url>                 sensitive-file scan -- .git/.env/actuator/
                                         phpinfo/config-backups, confirmed by
                                         content signature
  nullock audit <url> [method] [body-file|-] [hdr:val ...]
                                         deep scan -- runs the whole battery
                                         (param mining, verb-tampering, CORS,
                                         IDOR, mass-assignment, open-redirect,
                                         cache-poisoning, SSTI, secrets, CRLF,
                                         path-traversal, command-injection,
                                         reflected-XSS, SQL-injection, NoSQL,
                                         XXE) in one call
  nullock audit all [url1 url2 ...]      session-wide sweep -- deep-audits the
                                         given urls + every captured history
                                         row with params/body (async)
  nullock audit history                  sweep just the captured history rows

EOF
}

# ---- dispatch ----------------------------------------------------------
have curl || die "curl is required"
# jq is required for most subcommands; warn but don't bail.
if ! have "$JQ"; then
    echo "nullock: warning: jq not found -- output will be raw JSON" >&2
fi

case ${1:-help} in
    status)        shift; cmd_status "$@"        ;;
    scan)          shift; cmd_scan "$@"          ;;
    recon)         shift; cmd_recon "$@"         ;;
    probe-all)     shift; cmd_probe_all "$@"     ;;
    findings)      shift; cmd_findings "$@"      ;;
    history)       shift; cmd_history "$@"       ;;
    history-show)  shift; cmd_history_show "$@"  ;;
    replay)        shift; cmd_replay "$@"        ;;
    rule)          shift; cmd_rule "$@"          ;;
    intercept)     shift; cmd_intercept "$@"     ;;
    repeater)      shift; cmd_repeater "$@"      ;;
    intruder)      shift; cmd_intruder "$@"      ;;
    ws)            shift; cmd_ws "$@"            ;;
    oast)          shift; cmd_oast "$@"          ;;
    session-rules) shift; cmd_session_rules "$@" ;;
    crawler)       shift; cmd_crawler "$@"       ;;
    openapi)       shift; cmd_openapi "$@"       ;;
    h2)            shift; cmd_h2 "$@"            ;;
    cookies)       shift; cmd_cookies "$@"       ;;
    triage)        shift; cmd_triage "$@"        ;;
    extensions)    shift; cmd_extensions "$@"    ;;
    report)        shift; cmd_report "$@"        ;;
    update)        shift; cmd_update "$@"        ;;
    project)       shift; cmd_project "$@"       ;;
    export)        shift; cmd_export "$@"        ;;
    sequencer)     shift; cmd_sequencer "$@"     ;;
    payloads)      shift; cmd_payloads "$@"      ;;
    authz)         shift; cmd_authz "$@"         ;;
    grouped)       shift; cmd_grouped "$@"       ;;
    cve)           shift; cmd_cve "$@"           ;;
    graphql)       shift; cmd_graphql "$@"       ;;
    chain)         shift; cmd_chain "$@"         ;;
    jwt)           shift; cmd_jwt "$@"           ;;
    paramminer)    shift; cmd_paramminer "$@"    ;;
    idor)          shift; cmd_idor "$@"          ;;
    massassign)    shift; cmd_massassign "$@"    ;;
    cors)          shift; cmd_cors "$@"          ;;
    jsrecon)       shift; cmd_jsrecon "$@"       ;;
    race)          shift; cmd_race "$@"          ;;
    verbtamper)    shift; cmd_verbtamper "$@"    ;;
    ssti)          shift; cmd_ssti "$@"          ;;
    cachepoison)   shift; cmd_cachepoison "$@"   ;;
    openredirect)  shift; cmd_openredirect "$@"  ;;
    headeraudit)   shift; cmd_headeraudit "$@"   ;;
    secrets)       shift; cmd_secrets "$@"       ;;
    crlf)          shift; cmd_crlf "$@"          ;;
    lfi)           shift; cmd_lfi "$@"           ;;
    cmdi)          shift; cmd_cmdi "$@"          ;;
    xss)           shift; cmd_xss "$@"           ;;
    sqli)          shift; cmd_sqli "$@"          ;;
    xxe)           shift; cmd_xxe "$@"           ;;
    nosqli)        shift; cmd_nosqli "$@"        ;;
    smuggle)       shift; cmd_smuggle "$@"       ;;
    vulnscan)      shift; cmd_vulnscan "$@"      ;;
    tls)           shift; cmd_tls "$@"           ;;
    fingerprint)   shift; cmd_fingerprint "$@"   ;;
    methods)       shift; cmd_methods "$@"       ;;
    takeover)      shift; cmd_takeover "$@"      ;;
    exposure)      shift; cmd_exposure "$@"      ;;
    assess)        shift; cmd_assess "$@"        ;;
    audit)         shift; cmd_audit "$@"         ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown subcommand: $1. Try 'nullock help'." ;;
esac
