cmd_ssti() {
    # nullock ssti <url> <param> [in] [method] [Header:Value ...]
    #   in: query (default) | form | json
    [[ -n ${1-} && -n ${2-} ]] || die "usage: nullock ssti <url> <param> [query|form|json] [method] [hdr:val ...]"
    local url=$1 param=$2; shift 2
    local loc="query"
    if [[ -n ${1-} && $1 != *:* && ( $1 == query || $1 == form || $1 == json ) ]]; then loc=$1; shift; fi
    local method="GET"
    if [[ -n ${1-} && $1 != *:* ]]; then method=$1; shift; fi
    local headers="{}"
    if (( $# > 0 )); then
        headers="{"; local first=1
        for h in "$@"; do
            local name=${h%%:*} val=${h#*:}; val=${val# }
            if (( first )); then first=0; else headers+=","; fi
            headers+="$(jsonq "$name"):$(jsonq "$val")"
        done
        headers+="}"
    fi
    post /api/ssti/test "{\"url\":$(jsonq "$url"),\"param\":$(jsonq "$param"),\"in\":$(jsonq "$loc"),\"method\":$(jsonq "$method"),\"headers\":$headers}" | pp
}

