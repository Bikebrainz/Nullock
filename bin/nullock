#!/usr/bin/env bash
# nullock -- thin CLI over the Nullock control-server REST API.
#
# Targets a running Nullock instance (default 127.0.0.1:17777). Doesn't
# spawn the app for you -- launch separately, ideally with --headless
# --ndjson if you want to tail events too:
#
#     NullockApp --headless --ndjson &
#     nullock status
#
# Override the API URL with $NULLOCK_API. Override jq path with $JQ.

set -euo pipefail

API="${NULLOCK_API:-http://127.0.0.1:17777}"
JQ="${JQ:-jq}"
ORIGIN_HEADER="-H Origin: $API"   # satisfy the CSRF guard from this script

# ---- helpers -----------------------------------------------------------
die()  { echo "nullock: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# POST <path> [<json-body>]
post() {
    local path=$1; shift || true
    local body=${1:-'{}'}
    curl -sS --max-time 30 \
         -H "Content-Type: application/json" \
         -H "Origin: $API" \
         -H "X-Nullock-UI: 1" \
         -X POST -d "$body" \
         "$API$path"
}

# GET <path>
get() {
    local path=$1
    curl -sS --max-time 30 "$API$path"
}

# Read .repeater / .intruder / .interceptEnabled / ... out of the snapshot
# without round-tripping again -- many subcommands need both a write and
# a follow-up read, so cache the JSON once per invocation.
snapshot() {
    curl -sS --max-time 5 "$API/api/snapshot"
}

# Pretty-print if jq is around, raw otherwise.
pp() {
    if have "$JQ"; then "$JQ" "${1:-.}" ; else cat ; fi
}

# ---- subcommands -------------------------------------------------------

cmd_status() {
    curl -sS --max-time 5 "$API/api/snapshot" | pp '{
        proxy:    .bootInfo.port,
        proxyOn:  .bootInfo.proxyOn,
        control:  .bootInfo.controlPort,
        project:  .bootInfo.project,
        rows:     (.rows | length),
        findings: .findingsCount,
        rules:    (.rules | length),
        rulesHit: .rulesHit
    }'
}

cmd_scan() {
    # nullock scan <host-or-cidr-or-comma-list> [preset]
    [[ -n ${1-} ]] || die "usage: nullock scan <host|cidr|a,b,c> [discovery|top100|web|full1024]"
    local target=$1
    local preset=${2:-top100}
    local field='host'
    case $target in
        */*)  field='cidr'  ;;
        *,*)  field='hosts' ; target="[\"${target//,/\",\"}\"]" ; target_quoted=$target ;;
    esac
    local body
    if [[ $field == hosts ]]; then
        body="{\"hosts\":$target,\"preset\":\"$preset\",\"timeoutMs\":1000}"
    else
        body="{\"$field\":\"$target\",\"preset\":\"$preset\",\"timeoutMs\":1000}"
    fi
    post /api/portscan/start "$body" > /dev/null
    # Poll until done.
    while :; do
        local s
        s=$(curl -sS --max-time 5 "$API/api/snapshot")
        local running done_count total
        running=$(echo "$s" | "$JQ" -r '.portScan.running')
        done_count=$(echo "$s" | "$JQ" -r '.portScan.done')
        total=$(echo "$s" | "$JQ" -r '.portScan.total')
        echo "  $done_count/$total $( [[ $running == true ]] && echo running || echo done )" >&2
        [[ $running == false ]] && break
        sleep 1
    done
    curl -sS --max-time 5 "$API/api/snapshot" | "$JQ" '[
        .portScan.results[] | select(.status=="open") |
        { host, port, service, banner: (.banner // "" | .[0:80]) }
    ]'
}

cmd_recon() {
    [[ -n ${1-} ]] || die "usage: nullock recon <domain>"
    local d=$1
    post /api/recon/dns      "{\"domain\":\"$d\"}" > /dev/null
    post /api/recon/wordlist "{\"domain\":\"$d\",\"subdomains\":[\"www\",\"mail\",\"api\",\"admin\",\"dev\",\"staging\",\"vpn\",\"portal\",\"login\",\"git\",\"docs\",\"app\",\"ns1\",\"ns2\",\"mx\"]}" > /dev/null
    # Wait a few seconds for async lookups.
    sleep 4
    curl -sS --max-time 5 "$API/api/snapshot" | "$JQ" '{
        target: .recon.target,
        dns: [.recon.dns[] | {type, value, priority}],
        subdomains: [.recon.subdomains[] | {name, source, ips}]
    }'
}

cmd_probe_all() {
    local throttle=${1:-200}
    local limit=${2:-50}
    post /api/probe/all "{\"throttleMs\":$throttle,\"limit\":$limit}" | pp
}

cmd_findings() {
    local sev=${1:-}
    if [[ -n $sev ]]; then
        curl -sS --max-time 5 "$API/api/snapshot" \
            | "$JQ" "[.findings[] | select(.severity==\"$sev\") | {severity, kind, rowId, summary, url}]"
    else
        curl -sS --max-time 5 "$API/api/snapshot" \
            | "$JQ" '[.findings[] | {severity, kind, rowId, summary, url}]'
    fi
}

cmd_history() {
    # nullock history [n]
    local n=${1:-20}
    curl -sS --max-time 5 "$API/api/snapshot" \
        | "$JQ" "[.rows[-$n:] | .[] | {id, method, host, path, status, size}]"
}

cmd_history_show() {
    [[ -n ${1-} ]] || die "usage: nullock history-show <row-id>"
    echo "--- request ---"
    curl -sS --max-time 5 "$API/api/history/$1/request"
    echo
    echo "--- response ---"
    curl -sS --max-time 5 "$API/api/history/$1/response"
}

cmd_replay() {
    [[ -n ${1-} ]] || die "usage: nullock replay <row-id>"
    post "/api/history/$1/replay" '{}' | pp
}

cmd_export() {
    case ${1:-} in
        nmap)      curl -sS "$API/api/export/nmap-xml" ;;
        sarif)     curl -sS "$API/api/export/sarif" ;;
        postman)   curl -sS "$API/api/export/postman" ;;
        har)       post /api/har/export | pp ;;
        *) die "usage: nullock export {nmap|sarif|postman|har}" ;;
    esac
}

cmd_rule() {
    # nullock rule add <name> <section> <find> <replace>
    case ${1:-} in
        add)
            [[ $# -ge 5 ]] || die "usage: nullock rule add <name> <section:0-5> <find> <replace>"
            post /api/rules/add "{\"enabled\":true,\"name\":\"$2\",\"section\":$3,\"find\":\"$4\",\"replace\":\"$5\"}" | pp
            ;;
        list)
            curl -sS --max-time 5 "$API/api/snapshot" \
                | "$JQ" '[.rules[] | {enabled, name, section, find, replace}]'
            ;;
        clear)
            # No clear endpoint; remove until empty.
            while :; do
                local count
                count=$(curl -sS --max-time 5 "$API/api/snapshot" | "$JQ" '.rules | length')
                [[ $count == 0 ]] && break
                post /api/rules/remove '{"index":0}' >/dev/null
            done
            echo "cleared"
            ;;
        *) die "usage: nullock rule {add|list|clear} [args...]" ;;
    esac
}

cmd_intercept() {
    case ${1:-} in
        on|toggle) post /api/intercept/toggle | pp ;;
        forward)   post /api/intercept/forwardAll | pp ;;
        drop)      post /api/intercept/drop | pp ;;
        queue)
            snapshot \
                | "$JQ" '{ enabled: .interceptEnabled, queue: (.intercepted | length) }'
            ;;
        *) die "usage: nullock intercept {toggle|forward|drop|queue}" ;;
    esac
}

# Shell-escape a string for embedding inside a JSON string literal.
# Wraps the input by piping through jq -Rs . which produces a properly
# escaped, quoted JSON string (handles ", \, newlines, control bytes).
# Falls back to a naive escape if jq isn't available -- good enough for
# anything that isn't actively trying to break out.
jsonq() {
    if have "$JQ"; then printf '%s' "$1" | "$JQ" -Rs .
    else printf '"%s"' "${1//\"/\\\"}"
    fi
}

cmd_repeater() {
    # nullock repeater {set|send|show|response|clear|load|tabs|tab ...}
    case ${1:-} in
        set)
            # nullock repeater set <host> <port> <tls:true|false> [request-file|-]
            [[ $# -ge 4 ]] || die "usage: nullock repeater set <host> <port> <tls> [request-file|-]"
            local host=$2 port=$3 tls=$4 req=""
            if [[ -n ${5-} ]]; then
                if [[ $5 == "-" ]]; then req=$(cat); else req=$(cat "$5"); fi
            fi
            local body
            body="{\"host\":$(jsonq "$host"),\"port\":$port,\"tls\":$tls"
            if [[ -n $req ]]; then body+=",\"request\":$(jsonq "$req")"; fi
            body+="}"
            post /api/repeater/set "$body" | pp
            ;;
        send)
            # Fire and wait briefly for the response to settle into snapshot.
            post /api/repeater/send >/dev/null
            local i=0
            while (( i < 60 )); do
                local busy
                busy=$(snapshot | "$JQ" -r '.repeater.busy')
                [[ $busy == false ]] && break
                sleep 0.25
                ((i++))
            done
            snapshot | "$JQ" '{
                status: .repeater.statusLine,
                response: (.repeater.response | .[0:2000])
            }'
            ;;
        show)
            # Show the loaded request that would be fired next.
            snapshot | "$JQ" '{
                host: .repeater.host, port: .repeater.port, tls: .repeater.tls,
                activeTab: .repeater.activeTab,
                request: .repeater.request
            }'
            ;;
        response)
            # Full response from the last send.
            snapshot | "$JQ" -r '.repeater.response'
            ;;
        clear)
            post /api/repeater/clear | pp
            ;;
        load)
            # nullock repeater load <row-id>  -- pull a captured row into the active tab.
            [[ -n ${2-} ]] || die "usage: nullock repeater load <row-id>"
            local row=$2
            # Two API options: history/<id>/request gives us the bytes; the cleaner
            # path is the tab/addFromHistory endpoint (also wraps a fresh tab).
            post /api/repeater/tab/addFromHistory "{\"row\":$row}" | pp
            ;;
        tabs)
            snapshot | "$JQ" '{
                active: .repeater.activeTab,
                tabs: [.repeater.tabs[] | {name, host, port, tls, hasResponse: (.responseText != "")}]
            }'
            ;;
        tab)
            # nullock repeater tab {add|close|activate|rename|duplicate} ...
            case ${2:-} in
                add)
                    post /api/repeater/tab/add "{\"name\":$(jsonq "${3:-}")}" | pp ;;
                close)
                    [[ -n ${3-} ]] || die "usage: nullock repeater tab close <index>"
                    post /api/repeater/tab/close "{\"index\":$3}" | pp ;;
                activate)
                    [[ -n ${3-} ]] || die "usage: nullock repeater tab activate <index>"
                    post /api/repeater/tab/activate "{\"index\":$3}" | pp ;;
                rename)
                    [[ $# -ge 4 ]] || die "usage: nullock repeater tab rename <index> <name>"
                    post /api/repeater/tab/rename "{\"index\":$3,\"name\":$(jsonq "$4")}" | pp ;;
                duplicate)
                    [[ -n ${3-} ]] || die "usage: nullock repeater tab duplicate <index>"
                    post /api/repeater/tab/duplicate "{\"index\":$3}" | pp ;;
                *) die "usage: nullock repeater tab {add|close|activate|rename|duplicate}" ;;
            esac
            ;;
        *) die "usage: nullock repeater {set|send|show|response|clear|load|tabs|tab ...}" ;;
    esac
}

cmd_intruder() {
    # nullock intruder {set|start|stop|clear|status|results|resend}
    case ${1:-} in
        set)
            # nullock intruder set <host> <port> <tls> <template-file|-> <payloads-file|-|>
            # Either file argument can be "-" to read stdin. Payloads is
            # one entry per line; the §marker§ in the template (or
            # whichever marker is configured in the project) is replaced
            # with each payload at fire time.
            [[ $# -ge 4 ]] || die "usage: nullock intruder set <host> <port> <tls> [template-file|-] [payloads-file|-]"
            local host=$2 port=$3 tls=$4
            local tmpl="" payloads=""
            if [[ -n ${5-} ]]; then
                if [[ $5 == "-" ]]; then tmpl=$(cat); else tmpl=$(cat "$5"); fi
            fi
            if [[ -n ${6-} ]]; then
                if [[ $6 == "-" ]]; then payloads=$(cat); else payloads=$(cat "$6"); fi
            fi
            local body
            body="{\"host\":$(jsonq "$host"),\"port\":$port,\"tls\":$tls"
            if [[ -n $tmpl ]]; then body+=",\"template\":$(jsonq "$tmpl")"; fi
            if [[ -n $payloads ]]; then body+=",\"payloads\":$(jsonq "$payloads")"; fi
            body+="}"
            post /api/intruder/set "$body" | pp
            ;;
        start)
            post /api/intruder/start | pp ;;
        stop)
            post /api/intruder/stop | pp ;;
        clear)
            post /api/intruder/clear | pp ;;
        status)
            snapshot | "$JQ" '{
                host: .intruder.host, port: .intruder.port, tls: .intruder.tls,
                running: .intruder.running,
                payloads: (.intruder.payloads | length),
                results: (.intruder.results | length)
            }'
            ;;
        results)
            # Optional filter on status code or length.
            local filter='.'
            if [[ -n ${2-} ]]; then
                # Treat numeric arg as status code filter.
                if [[ $2 =~ ^[0-9]+$ ]]; then
                    filter=".[] | select(.status==$2)"
                else
                    die "usage: nullock intruder results [<status-code>]"
                fi
            fi
            snapshot \
                | "$JQ" "[.intruder.results[] | {row: .row, payload, status, length, time}] | map($filter)"
            ;;
        resend)
            [[ -n ${2-} ]] || die "usage: nullock intruder resend <row-index>"
            post /api/intruder/resend "{\"row\":$2}" | pp ;;
        *) die "usage: nullock intruder {set|start|stop|clear|status|results|resend}" ;;
    esac
}

cmd_ws() {
    # WebSocket repeater control.
    case ${1:-} in
        sessions)
            curl -sS --max-time 5 "$API/api/ws/sessions" | pp
            ;;
        send)
            # nullock ws send <session-id> <up|down> <opcode> <payload>
            [[ $# -ge 4 ]] || die "usage: nullock ws send <id> <up|down> <opcode-int> [payload]"
            local body="{\"sessionId\":$2,\"direction\":$(jsonq "$3"),\"opcode\":$4"
            if [[ -n ${5-} ]]; then body+=",\"payload\":$(jsonq "$5")"; fi
            body+="}"
            post /api/ws/send "$body" | pp
            ;;
        *) die "usage: nullock ws {sessions|send <id> <dir> <opcode> [payload]}" ;;
    esac
}

cmd_oast() {
    # Out-of-band callback sink.
    case ${1:-} in
        mint)
            # nullock oast mint [host] [param] [note]
            # With a host arg, registers the token for auto-correlation:
            # when the callback lands, a confirmed finding appears by
            # itself. Paste the returned pathUrl into a Repeater request.
            if [[ -n ${2-} ]]; then
                local body="{\"register\":true,\"host\":$(jsonq "$2")"
                [[ -n ${3-} ]] && body+=",\"param\":$(jsonq "$3")"
                [[ -n ${4-} ]] && body+=",\"note\":$(jsonq "$4")"
                body+="}"
                post /api/oast/mint "$body" | pp
            else
                post /api/oast/mint | pp
            fi
            ;;
        blast)
            # nullock oast blast <url>
            # Spray OOB payloads (SSRF param battery + blind XXE) at a
            # target; each callback auto-confirms with its attack class.
            [[ -n ${2-} ]] || die "usage: nullock oast blast <url>"
            post /api/oast/blast "{\"url\":$(jsonq "$2")}" | pp
            ;;
        poll)
            local since=${2:-0}
            curl -sS --max-time 5 "$API/api/oast/poll?since=$since" | pp
            ;;
        status)
            # Includes registered/confirmed correlation counts.
            snapshot | "$JQ" '.oast'
            ;;
        watch)
            # Tail mode: poll every 2s, only show new hits.
            local since=0
            while :; do
                local resp
                resp=$(curl -sS --max-time 5 "$API/api/oast/poll?since=$since")
                local hits
                hits=$(echo "$resp" | "$JQ" '.hits | length')
                if [[ $hits -gt 0 ]]; then
                    echo "$resp" | "$JQ" '.hits[] | "[" + (.atMs|tostring) + "] " + .sourceIp + " " + .method + " " + .hostHeader + .path + "  (tok=" + .token + ")"'
                    since=$(echo "$resp" | "$JQ" '.hits | last | .id')
                fi
                sleep 2
            done
            ;;
        *) die "usage: nullock oast {mint|poll [since]|status|watch}" ;;
    esac
}

cmd_session_rules() {
    case ${1:-} in
        list)
            snapshot | "$JQ" '.sessionRules'
            ;;
        clear-vars)
            post /api/session-rules/clear-vars | pp
            ;;
        set)
            # nullock session-rules set <rule-file.json>
            # File contents: an array of SessionRule objects.
            [[ -n ${2-} ]] || die "usage: nullock session-rules set <rule-file.json>"
            local rules
            if [[ $2 == "-" ]]; then rules=$(cat); else rules=$(cat "$2"); fi
            post /api/session-rules/set "{\"rules\":$rules}" | pp
            ;;
        *) die "usage: nullock session-rules {list|set <file>|clear-vars}" ;;
    esac
}

cmd_crawler() {
    case ${1:-} in
        start)
            # nullock crawler start <seed> [maxPages] [maxDepth] [throttleMs]
            [[ -n ${2-} ]] || die "usage: nullock crawler start <seed-url> [maxPages] [maxDepth] [throttleMs]"
            local body
            body="{\"seed\":$(jsonq "$2"),\"maxPages\":${3:-200},\"maxDepth\":${4:-4},\"throttleMs\":${5:-200}}"
            post /api/crawler/start "$body" | pp
            ;;
        stop)
            post /api/crawler/stop | pp
            ;;
        status)
            snapshot | "$JQ" '{ running: .crawler.running, visited: .crawler.visited, queued: .crawler.queued, seed: .crawler.seed }'
            ;;
        *) die "usage: nullock crawler {start <seed>|stop|status}" ;;
    esac
}

cmd_openapi() {
    case ${1:-} in
        import)
            # nullock openapi import <spec-file.json> [base-url]
            [[ -n ${2-} ]] || die "usage: nullock openapi import <spec-file.json> [base-url]"
            local spec
            if [[ $2 == "-" ]]; then spec=$(cat); else spec=$(cat "$2"); fi
            local body="{\"spec\":$(jsonq "$spec")"
            if [[ -n ${3-} ]]; then body+=",\"baseUrl\":$(jsonq "$3")"; fi
            body+="}"
            post /api/openapi/import "$body" | pp
            ;;
        export)
            # Reverse: dump captured history as an OpenAPI 3.1 spec.
            curl -sS --max-time 30 "$API/api/openapi/export" | pp
            ;;
        *) die "usage: nullock openapi {import <spec-file.json> [base-url]|export}" ;;
    esac
}

cmd_h2() {
    case ${1:-} in
        streams)
            curl -sS --max-time 5 "$API/api/h2/streams" | pp
            ;;
        events)
            curl -sS --max-time 5 "$API/api/h2/events?since=${2:-0}" | pp
            ;;
        watch)
            local since=0
            while :; do
                local resp
                resp=$(curl -sS --max-time 5 "$API/api/h2/events?since=$since")
                local count
                count=$(echo "$resp" | "$JQ" '.events | length')
                if [[ $count -gt 0 ]]; then
                    echo "$resp" | "$JQ" -r '.events[] | "[" + (.ts|tostring) + "] " + .conn + " s" + (.streamId|tostring) + " " + .type + " " + (.bytes|tostring) + "B"'
                    since=$(echo "$resp" | "$JQ" '.events | last | .ts')
                fi
                sleep 1
            done
            ;;
        *) die "usage: nullock h2 {streams|events [since-ms]|watch}" ;;
    esac
}

cmd_cookies() {
    curl -sS --max-time 5 "$API/api/cookies" | pp
}

cmd_triage() {
    # nullock triage <rowId> [kind] [severity] [summary] [evidence]
    # Sends a finding-shaped triage request to the local Ollama model.
    [[ -n ${1-} ]] || die "usage: nullock triage <rowId> [kind] [severity] [summary] [evidence]"
    local body
    body="{\"rowId\":$1,\"kind\":$(jsonq "${2:-protocol-graphql}"),\"severity\":$(jsonq "${3:-info}"),\"summary\":$(jsonq "${4:-Manual triage request}"),\"evidence\":$(jsonq "${5:-}")}"
    post /api/triage/finding "$body" | pp
}

cmd_extensions() {
    case ${1:-} in
        install-builtins)
            post /api/extensions/install-builtins | pp ;;
        reload)
            post /api/extensions/reload | pp ;;
        *) die "usage: nullock extensions {install-builtins|reload}" ;;
    esac
}

cmd_project() {
    case ${1:-} in
        list)
            curl -sS --max-time 5 "$API/api/project/list" | pp
            ;;
        open)
            [[ -n ${2-} ]] || die "usage: nullock project open <name>"
            post /api/project/open "{\"name\":\"$2\"}" | pp
            ;;
        create)
            [[ -n ${2-} ]] || die "usage: nullock project create <name>"
            post /api/project/create "{\"name\":\"$2\"}" | pp
            ;;
        templates)
            curl -sS --max-time 5 "$API/api/project/templates" | pp
            ;;
        from-template)
            # nullock project from-template <templateId> <projectName>
            [[ $# -ge 3 ]] || die "usage: nullock project from-template <templateId> <projectName>"
            post /api/project/create-from-template "{\"templateId\":$(jsonq "$2"),\"projectName\":$(jsonq "$3")}" | pp
            ;;
        clear-history)
            post /api/clear-history | pp
            ;;
        *) die "usage: nullock project {list|open|create|templates|from-template <id> <name>|clear-history} [args...]" ;;
    esac
}

cmd_report() {
    case ${1:-} in
        build)
            local out=${2:-nullock-report.md}
            curl -sS --max-time 30 -X POST -H "Origin: $API" -H "X-Nullock-UI: 1" \
                "$API/api/report/build" -o "$out"
            echo "wrote $out"
            ;;
        *) die "usage: nullock report build [output.md]" ;;
    esac
}

cmd_update() {
    snapshot | "$JQ" '.update // {error: "update info not in snapshot yet"}'
}

cmd_sequencer() {
    # nullock sequencer <token1> [token2 ...]
    # Token randomness analyzer (Shannon entropy + run tests).
    [[ -n ${1-} ]] || die "usage: nullock sequencer <token1> [token2 ...]"
    local tokens="["
    local first=1
    for t in "$@"; do
        if (( first )); then first=0; else tokens+=","; fi
        tokens+=$(jsonq "$t")
    done
    tokens+="]"
    post /api/sequencer/analyze "{\"tokens\":$tokens}" | pp
}

cmd_payloads() {
    # nullock payloads <kind> [count]
    # AI-generated payloads via local Ollama. kind = xss|sqli|ssti|...
    [[ -n ${1-} ]] || die "usage: nullock payloads <kind> [count]"
    local count=${2:-10}
    post /api/payloads/generate \
        "{\"kind\":$(jsonq "$1"),\"count\":$count}" | pp
}

cmd_authz() {
    # nullock authz <rowId> <user1-cookie> <user2-cookie> [user3-cookie ...]
    # Replay one row as each user; flag rows where status/length agrees
    # (privilege escalation surface).
    [[ $# -ge 3 ]] || die "usage: nullock authz <rowId> <user-cookie> <user-cookie> [...]"
    local row=$1; shift
    local cookies="["
    local first=1
    for c in "$@"; do
        if (( first )); then first=0; else cookies+=","; fi
        cookies+=$(jsonq "$c")
    done
    cookies+="]"
    post /api/authz-test "{\"rowId\":$row,\"cookies\":$cookies}" | pp
}

cmd_grouped() {
    # Findings grouped + deduped (Burp "issue activity" equivalent).
    curl -sS --max-time 5 "$API/api/findings/grouped" | pp
}

cmd_audit() {
    # nullock audit <url> [method] [body-file|-] [Header:Value ...]
    # nullock audit all [url1 url2 ...]      # sweep history + given urls
    # nullock audit history                  # sweep captured history rows
    # Runs the whole active-testing battery.
    if [[ ${1-} == "all" || ${1-} == "history" ]]; then
        local mode=$1; shift
        local urls="["
        local first=1
        for u in "$@"; do
            if (( first )); then first=0; else urls+=","; fi
            urls+=$(jsonq "$u")
        done
        urls+="]"
        local fromHist="true"
        [[ $mode == "all" && $# -gt 0 ]] && fromHist="true"
        post /api/audit/all "{\"urls\":$urls,\"fromHistory\":$fromHist}" | pp
        return
    fi
    [[ -n ${1-} ]] || die "usage: nullock audit <url> [method] [body|-] [hdr:val] | audit all [urls...] | audit history"
    local url=$1; shift
    local method="GET"
    if [[ -n ${1-} && $1 =~ ^(GET|POST|PUT|PATCH|DELETE|get|post|put|patch|delete)$ ]]; then method=$1; shift; fi
    local body=""
    if [[ -n ${1-} && $1 != *:* ]]; then
        if [[ $1 == "-" ]]; then body=$(cat); else body=$(cat "$1"); fi
        shift
    fi
    local headers="{}"
    if (( $# > 0 )); then
        headers="{"; local first=1
        for h in "$@"; do
            local name=${h%%:*} val=${h#*:}; val=${val# }
            if (( first )); then first=0; else headers+=","; fi
            headers+="$(jsonq "$name"):$(jsonq "$val")"
        done
        headers+="}"
    fi
    local b="{\"url\":$(jsonq "$url"),\"method\":$(jsonq "$method"),\"headers\":$headers"
    [[ -n $body ]] && b+=",\"body\":$(jsonq "$body")"
    b+="}"
    post /api/audit/run "$b" | pp
}

