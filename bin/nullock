cmd_race() {
    # nullock race <url> [count] [method] [body-file|-] [Header:Value ...]
    [[ -n ${1-} ]] || die "usage: nullock race <url> [count] [method] [body-file|-] [Header:Value ...]"
    local url=$1; shift
    local count=20
    if [[ -n ${1-} && $1 =~ ^[0-9]+$ ]]; then count=$1; shift; fi
    local method="POST"
    if [[ -n ${1-} && $1 =~ ^(POST|PUT|PATCH|GET|DELETE|post|put|patch|get|delete)$ ]]; then method=$1; shift; fi
    local body=""
    if [[ -n ${1-} && $1 != *:* ]]; then
        if [[ $1 == "-" ]]; then body=$(cat); else body=$(cat "$1"); fi
        shift
    fi
    local headers="{}"
    if (( $# > 0 )); then
        headers="{"; local first=1
        for h in "$@"; do
            local name=${h%%:*} val=${h#*:}; val=${val# }
            if (( first )); then first=0; else headers+=","; fi
            headers+="$(jsonq "$name"):$(jsonq "$val")"
        done
        headers+="}"
    fi
    local b="{\"url\":$(jsonq "$url"),\"count\":$count,\"method\":$(jsonq "$method"),\"headers\":$headers"
    [[ -n $body ]] && b+=",\"body\":$(jsonq "$body")"
    b+="}"
    post /api/race/test "$b" | pp
}

