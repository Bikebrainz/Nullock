#!/usr/bin/env bash
# nullock -- thin CLI over the Nullock control-server REST API.
#
# Targets a running Nullock instance (default 127.0.0.1:17777). Doesn't
# spawn the app for you -- launch separately, ideally with --headless
# --ndjson if you want to tail events too:
#
#     NullockApp --headless --ndjson &
#     nullock status
#
# Override the API URL with $NULLOCK_API. Override jq path with $JQ.

set -euo pipefail

API="${NULLOCK_API:-http://127.0.0.1:17777}"
JQ="${JQ:-jq}"
ORIGIN_HEADER="-H Origin: $API"   # satisfy the CSRF guard from this script

# ---- helpers -----------------------------------------------------------
die()  { echo "nullock: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# POST <path> [<json-body>]
post() {
    local path=$1; shift || true
    local body=${1:-'{}'}
    curl -sS --max-time 30 \
         -H "Content-Type: application/json" \
         -H "Origin: $API" \
         -H "X-Nullock-UI: 1" \
         -X POST -d "$body" \
         "$API$path"
}

# GET <path>
get() {
    local path=$1
    curl -sS --max-time 30 "$API$path"
}

# Read .repeater / .intruder / .interceptEnabled / ... out of the snapshot
# without round-tripping again -- many subcommands need both a write and
# a follow-up read, so cache the JSON once per invocation.
snapshot() {
    curl -sS --max-time 5 "$API/api/snapshot"
}

# Pretty-print if jq is around, raw otherwise.
pp() {
    if have "$JQ"; then "$JQ" "${1:-.}" ; else cat ; fi
}

# ---- subcommands -------------------------------------------------------

cmd_status() {
    curl -sS --max-time 5 "$API/api/snapshot" | pp '{
        proxy:    .bootInfo.port,
        proxyOn:  .bootInfo.proxyOn,
        control:  .bootInfo.controlPort,
        project:  .bootInfo.project,
        rows:     (.rows | length),
        findings: .findingsCount,
        rules:    (.rules | length),
        rulesHit: .rulesHit
    }'
}

cmd_scan() {
    # nullock scan <host-or-cidr-or-comma-list> [preset]
    [[ -n ${1-} ]] || die "usage: nullock scan <host|cidr|a,b,c> [discovery|top100|web|full1024]"
    local target=$1
    local preset=${2:-top100}
    local field='host'
    case $target in
        */*)  field='cidr'  ;;
        *,*)  field='hosts' ; target="[\"${target//,/\",\"}\"]" ; target_quoted=$target ;;
    esac
    local body
    if [[ $field == hosts ]]; then
        body="{\"hosts\":$target,\"preset\":\"$preset\",\"timeoutMs\":1000}"
    else
        body="{\"$field\":\"$target\",\"preset\":\"$preset\",\"timeoutMs\":1000}"
    fi
    post /api/portscan/start "$body" > /dev/null
    # Poll until done.
    while :; do
        local s
        s=$(curl -sS --max-time 5 "$API/api/snapshot")
        local running done_count total
        running=$(echo "$s" | "$JQ" -r '.portScan.running')
        done_count=$(echo "$s" | "$JQ" -r '.portScan.done')
        total=$(echo "$s" | "$JQ" -r '.portScan.total')
        echo "  $done_count/$total $( [[ $running == true ]] && echo running || echo done )" >&2
        [[ $running == false ]] && break
        sleep 1
    done
    curl -sS --max-time 5 "$API/api/snapshot" | "$JQ" '[
        .portScan.results[] | select(.status=="open") |
        { host, port, service, banner: (.banner // "" | .[0:80]) }
    ]'
}

cmd_recon() {
    [[ -n ${1-} ]] || die "usage: nullock recon <domain>"
    local d=$1
    post /api/recon/dns      "{\"domain\":\"$d\"}" > /dev/null
    post /api/recon/wordlist "{\"domain\":\"$d\",\"subdomains\":[\"www\",\"mail\",\"api\",\"admin\",\"dev\",\"staging\",\"vpn\",\"portal\",\"login\",\"git\",\"docs\",\"app\",\"ns1\",\"ns2\",\"mx\"]}" > /dev/null
    # Wait a few seconds for async lookups.
    sleep 4
    curl -sS --max-time 5 "$API/api/snapshot" | "$JQ" '{
        target: .recon.target,
        dns: [.recon.dns[] | {type, value, priority}],
        subdomains: [.recon.subdomains[] | {name, source, ips}]
    }'
}

cmd_probe_all() {
    local throttle=${1:-200}
    local limit=${2:-50}
    post /api/probe/all "{\"throttleMs\":$throttle,\"limit\":$limit}" | pp
}

cmd_findings() {
    local sev=${1:-}
    if [[ -n $sev ]]; then
        curl -sS --max-time 5 "$API/api/snapshot" \
            | "$JQ" "[.findings[] | select(.severity==\"$sev\") | {severity, kind, rowId, summary, url}]"
    else
        curl -sS --max-time 5 "$API/api/snapshot" \
            | "$JQ" '[.findings[] | {severity, kind, rowId, summary, url}]'
    fi
}

cmd_history() {
    # nullock history [n]
    local n=${1:-20}
    curl -sS --max-time 5 "$API/api/snapshot" \
        | "$JQ" "[.rows[-$n:] | .[] | {id, method, host, path, status, size}]"
}

cmd_history_show() {
    [[ -n ${1-} ]] || die "usage: nullock history-show <row-id>"
    echo "--- request ---"
    curl -sS --max-time 5 "$API/api/history/$1/request"
    echo
    echo "--- response ---"
    curl -sS --max-time 5 "$API/api/history/$1/response"
}

cmd_replay() {
    [[ -n ${1-} ]] || die "usage: nullock replay <row-id>"
    post "/api/history/$1/replay" '{}' | pp
}

cmd_export() {
    case ${1:-} in
        nmap)      curl -sS "$API/api/export/nmap-xml" ;;
        sarif)     curl -sS "$API/api/export/sarif" ;;
        postman)   curl -sS "$API/api/export/postman" ;;
        har)       post /api/har/export | pp ;;
        *) die "usage: nullock export {nmap|sarif|postman|har}" ;;
    esac
}

cmd_rule() {
    # nullock rule add <name> <section> <find> <replace>
    case ${1:-} in
        add)
            [[ $# -ge 5 ]] || die "usage: nullock rule add <name> <section:0-5> <find> <replace>"
            post /api/rules/add "{\"enabled\":true,\"name\":\"$2\",\"section\":$3,\"find\":\"$4\",\"replace\":\"$5\"}" | pp
            ;;
        list)
            curl -sS --max-time 5 "$API/api/snapshot" \
                | "$JQ" '[.rules[] | {enabled, name, section, find, replace}]'
            ;;
        clear)
            # No clear endpoint; remove until empty.
            while :; do
                local count
                count=$(curl -sS --max-time 5 "$API/api/snapshot" | "$JQ" '.rules | length')
                [[ $count == 0 ]] && break
                post /api/rules/remove '{"index":0}' >/dev/null
            done
            echo "cleared"
            ;;
        *) die "usage: nullock rule {add|list|clear} [args...]" ;;
    esac
}

cmd_intercept() {
    case ${1:-} in
        on|toggle) post /api/intercept/toggle | pp ;;
        forward)   post /api/intercept/forwardAll | pp ;;
        drop)      post /api/intercept/drop | pp ;;
        queue)
            snapshot \
                | "$JQ" '{ enabled: .interceptEnabled, queue: (.intercepted | length) }'
            ;;
        *) die "usage: nullock intercept {toggle|forward|drop|queue}" ;;
    esac
}

# Shell-escape a string for embedding inside a JSON string literal.
# Wraps the input by piping through jq -Rs . which produces a properly
# escaped, quoted JSON string (handles ", \, newlines, control bytes).
# Falls back to a naive escape if jq isn't available -- good enough for
# anything that isn't actively trying to break out.
jsonq() {
    if have "$JQ"; then printf '%s' "$1" | "$JQ" -Rs .
    else printf '"%s"' "${1//\"/\\\"}"
    fi
}

cmd_repeater() {
    # nullock repeater {set|send|show|response|clear|load|tabs|tab ...}
    case ${1:-} in
        set)
            # nullock repeater set <host> <port> <tls:true|false> [request-file|-]
            [[ $# -ge 4 ]] || die "usage: nullock repeater set <host> <port> <tls> [request-file|-]"
            local host=$2 port=$3 tls=$4 req=""
            if [[ -n ${5-} ]]; then
                if [[ $5 == "-" ]]; then req=$(cat); else req=$(cat "$5"); fi
            fi
            local body
            body="{\"host\":$(jsonq "$host"),\"port\":$port,\"tls\":$tls"
            if [[ -n $req ]]; then body+=",\"request\":$(jsonq "$req")"; fi
            body+="}"
            post /api/repeater/set "$body" | pp
            ;;
        send)
            # Fire and wait briefly for the response to settle into snapshot.
            post /api/repeater/send >/dev/null
            local i=0
            while (( i < 60 )); do
                local busy
                busy=$(snapshot | "$JQ" -r '.repeater.busy')
                [[ $busy == false ]] && break
                sleep 0.25
                ((i++))
            done
            snapshot | "$JQ" '{
                status: .repeater.statusLine,
                response: (.repeater.response | .[0:2000])
            }'
            ;;
        show)
            # Show the loaded request that would be fired next.
            snapshot | "$JQ" '{
                host: .repeater.host, port: .repeater.port, tls: .repeater.tls,
                activeTab: .repeater.activeTab,
                request: .repeater.request
            }'
            ;;
        response)
            # Full response from the last send.
            snapshot | "$JQ" -r '.repeater.response'
            ;;
        clear)
            post /api/repeater/clear | pp
            ;;
        load)
            # nullock repeater load <row-id>  -- pull a captured row into the active tab.
            [[ -n ${2-} ]] || die "usage: nullock repeater load <row-id>"
            local row=$2
            # Two API options: history/<id>/request gives us the bytes; the cleaner
            # path is the tab/addFromHistory endpoint (also wraps a fresh tab).
            post /api/repeater/tab/addFromHistory "{\"row\":$row}" | pp
            ;;
        tabs)
            snapshot | "$JQ" '{
                active: .repeater.activeTab,
                tabs: [.repeater.tabs[] | {name, host, port, tls, hasResponse: (.responseText != "")}]
            }'
            ;;
        tab)
            # nullock repeater tab {add|close|activate|rename|duplicate} ...
            case ${2:-} in
                add)
                    post /api/repeater/tab/add "{\"name\":$(jsonq "${3:-}")}" | pp ;;
                close)
                    [[ -n ${3-} ]] || die "usage: nullock repeater tab close <index>"
                    post /api/repeater/tab/close "{\"index\":$3}" | pp ;;
                activate)
                    [[ -n ${3-} ]] || die "usage: nullock repeater tab activate <index>"
                    post /api/repeater/tab/activate "{\"index\":$3}" | pp ;;
                rename)
                    [[ $# -ge 4 ]] || die "usage: nullock repeater tab rename <index> <name>"
                    post /api/repeater/tab/rename "{\"index\":$3,\"name\":$(jsonq "$4")}" | pp ;;
                duplicate)
                    [[ -n ${3-} ]] || die "usage: nullock repeater tab duplicate <index>"
                    post /api/repeater/tab/duplicate "{\"index\":$3}" | pp ;;
                *) die "usage: nullock repeater tab {add|close|activate|rename|duplicate}" ;;
            esac
            ;;
        *) die "usage: nullock repeater {set|send|show|response|clear|load|tabs|tab ...}" ;;
    esac
}

cmd_intruder() {
    # nullock intruder {set|start|stop|clear|status|results|resend}
    case ${1:-} in
        set)
            # nullock intruder set <host> <port> <tls> <template-file|-> <payloads-file|-|>
            # Either file argument can be "-" to read stdin. Payloads is
            # one entry per line; the §marker§ in the template (or
            # whichever marker is configured in the project) is replaced
            # with each payload at fire time.
            [[ $# -ge 4 ]] || die "usage: nullock intruder set <host> <port> <tls> [template-file|-] [payloads-file|-]"
            local host=$2 port=$3 tls=$4
            local tmpl="" payloads=""
            if [[ -n ${5-} ]]; then
                if [[ $5 == "-" ]]; then tmpl=$(cat); else tmpl=$(cat "$5"); fi
            fi
            if [[ -n ${6-} ]]; then
                if [[ $6 == "-" ]]; then payloads=$(cat); else payloads=$(cat "$6"); fi
            fi
            local body
            body="{\"host\":$(jsonq "$host"),\"port\":$port,\"tls\":$tls"
            if [[ -n $tmpl ]]; then body+=",\"template\":$(jsonq "$tmpl")"; fi
            if [[ -n $payloads ]]; then body+=",\"payloads\":$(jsonq "$payloads")"; fi
            body+="}"
            post /api/intruder/set "$body" | pp
            ;;
        start)
            post /api/intruder/start | pp ;;
        stop)
            post /api/intruder/stop | pp ;;
        clear)
            post /api/intruder/clear | pp ;;
        status)
            snapshot | "$JQ" '{
                host: .intruder.host, port: .intruder.port, tls: .intruder.tls,
                running: .intruder.running,
                payloads: (.intruder.payloads | length),
                results: (.intruder.results | length)
            }'
            ;;
        results)
            # Optional filter on status code or length.
            local filter='.'
            if [[ -n ${2-} ]]; then
                # Treat numeric arg as status code filter.
                if [[ $2 =~ ^[0-9]+$ ]]; then
                    filter=".[] | select(.status==$2)"
                else
                    die "usage: nullock intruder results [<status-code>]"
                fi
            fi
            snapshot \
                | "$JQ" "[.intruder.results[] | {row: .row, payload, status, length, time}] | map($filter)"
            ;;
        resend)
            [[ -n ${2-} ]] || die "usage: nullock intruder resend <row-index>"
            post /api/intruder/resend "{\"row\":$2}" | pp ;;
        *) die "usage: nullock intruder {set|start|stop|clear|status|results|resend}" ;;
    esac
}

cmd_project() {
    case ${1:-} in
        list)
            curl -sS --max-time 5 "$API/api/project/list" | pp
            ;;
        open)
            [[ -n ${2-} ]] || die "usage: nullock project open <name>"
            post /api/project/open "{\"name\":\"$2\"}" | pp
            ;;
        create)
            [[ -n ${2-} ]] || die "usage: nullock project create <name>"
            post /api/project/create "{\"name\":\"$2\"}" | pp
            ;;
        clear-history)
            post /api/clear-history | pp
            ;;
        *) die "usage: nullock project {list|open|create|clear-history} [name]" ;;
    esac
}

cmd_help() {
    cat <<EOF
nullock -- CLI for a running Nullock instance

Targets \$NULLOCK_API (default $API).
Requires curl + jq.

Status / inspection:
  nullock status                 quick summary (proxy / project / counts)
  nullock history [N]            last N captured rows (default 20)
  nullock history-show <id>      raw request + response for row <id>
  nullock findings [severity]    findings list (filter: high|medium|low|info)

Scanning:
  nullock scan <target> [preset] target = host / CIDR (1.2.3.0/24) / a,b,c
                                 preset = discovery|top100|web|full1024
                                 (default top100)
  nullock recon <domain>         DNS + small wordlist subdomain enum
  nullock probe-all [throttleMs] active probe across every row with params
  nullock replay <row-id>        re-fire row through proxy + mutations

Mutation:
  nullock rule add <name> <section> <find> <replace>
                                 section: 0=URL 1=req-header 2=req-body
                                          3=resp-header 4=resp-body 5=resp-status
  nullock rule list
  nullock rule clear

Intercept:
  nullock intercept toggle|forward|drop|queue

Repeater:
  nullock repeater set <host> <port> <tls> [request-file|-]
                                 load a request to fire (file or stdin)
  nullock repeater send          fire the active tab + return status + body preview
  nullock repeater show          inspect the loaded request
  nullock repeater response      raw response body from the last send
  nullock repeater load <row-id> add a captured row as a fresh tab
  nullock repeater clear         clear the active tab
  nullock repeater tabs          list tabs with active marker
  nullock repeater tab add [name]
  nullock repeater tab close <index>
  nullock repeater tab activate <index>
  nullock repeater tab rename <index> <name>
  nullock repeater tab duplicate <index>

Intruder:
  nullock intruder set <host> <port> <tls> [template-file|-] [payloads-file|-]
                                 payloads = one per line; \xC2\xA7marker\xC2\xA7 in template
  nullock intruder start         fire the attack (returns immediately)
  nullock intruder stop          interrupt a running attack
  nullock intruder clear         drop results + loaded state
  nullock intruder status        running flag, payload count, result count
  nullock intruder results [status]
                                 list results, optionally filtered by status code
  nullock intruder resend <row>  re-fire one result row

Project:
  nullock project list
  nullock project open <name>
  nullock project create <name>
  nullock project clear-history

Export:
  nullock export nmap | sarif | postman | har

EOF
}

# ---- dispatch ----------------------------------------------------------
have curl || die "curl is required"
# jq is required for most subcommands; warn but don't bail.
if ! have "$JQ"; then
    echo "nullock: warning: jq not found -- output will be raw JSON" >&2
fi

case ${1:-help} in
    status)        shift; cmd_status "$@"        ;;
    scan)          shift; cmd_scan "$@"          ;;
    recon)         shift; cmd_recon "$@"         ;;
    probe-all)     shift; cmd_probe_all "$@"     ;;
    findings)      shift; cmd_findings "$@"      ;;
    history)       shift; cmd_history "$@"       ;;
    history-show)  shift; cmd_history_show "$@"  ;;
    replay)        shift; cmd_replay "$@"        ;;
    rule)          shift; cmd_rule "$@"          ;;
    intercept)     shift; cmd_intercept "$@"     ;;
    repeater)      shift; cmd_repeater "$@"      ;;
    intruder)      shift; cmd_intruder "$@"      ;;
    project)       shift; cmd_project "$@"       ;;
    export)        shift; cmd_export "$@"        ;;
    help|-h|--help) cmd_help ;;
    *) die "unknown subcommand: $1. Try 'nullock help'." ;;
esac
