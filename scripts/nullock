#!/usr/bin/env bash
# Thin forwarder to the canonical CLI. The full command surface lives in
# bin/nullock; this shim exists only so an old PATH entry or muscle-memory that
# reaches scripts/nullock still gets every command instead of a stale subset.
# Do NOT add commands here -- edit bin/nullock.
here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
exec "$here/../bin/nullock" "$@"
