#!/usr/bin/env bash
# nullock -- thin CLI wrapper around a RUNNING Nullock control server.
#
# Nullock's UI is a browser control panel served by the in-app control server
# (default http://127.0.0.1:17777). This script drives that same REST API from
# the terminal, for scripting / CI / quick checks without the browser. Start
# Nullock first (NullockApp [--headless]); this talks to it.
#
# Usage:  nullock [--port N] [--host H] <command> [args]
#
#   status                     proxy/control/scan status (one line)
#   snapshot                   full state snapshot (JSON)
#   findings                   scanner findings (JSON array)
#   posture                    security posture grade (JSON)
#   recon <domain>             DNS + crt.sh + wordlist subdomain enum
#   whois <domain>             WHOIS lookup (IANA -> registry referral)
#   reverse <ip>               reverse DNS / PTR lookup
#   search <regex>             search captured history (req+resp)
#   headers <url>              security-header audit of a URL
#   waf <url>                  WAF/CDN detection
#   export <fmt>               nmap-xml | sarif | postman | sbom
#   report <html|json>         engagement report
#   pac                        print the proxy auto-config (PAC) file
#   raw <METHOD> <path> [body] call any /api/* endpoint directly
#
# Options:  --port N (default 17777)   --host H (default 127.0.0.1)
# Env:      NULLOCK_PORT, NULLOCK_HOST override the defaults.
#
# Exit status: 0 on a 2xx response; non-zero on a transport/HTTP error
#              (curl's own exit code), and 2 on a usage error.

set -euo pipefail

HOST="${NULLOCK_HOST:-127.0.0.1}"
PORT="${NULLOCK_PORT:-17777}"

# Print the leading comment block (the usage header) -- stops at the first
# non-comment line, so it can never leak script code past the header.
_usage() { awk 'NR>=2 { if ($0 ~ /^#/) { sub(/^# ?/,""); print } else if ($0 != "") exit }' "$0"; }

# --- option parsing (before the command) ---
while [ $# -gt 0 ]; do
  case "$1" in
    --port) [ $# -ge 2 ] || { echo "nullock: --port needs a value" >&2; exit 2; }; PORT="$2"; shift 2 ;;
    --host) [ $# -ge 2 ] || { echo "nullock: --host needs a value" >&2; exit 2; }; HOST="$2"; shift 2 ;;
    --port=*) PORT="${1#*=}"; shift ;;
    --host=*) HOST="${1#*=}"; shift ;;
    -h|--help) _usage; exit 0 ;;
    *) break ;;
  esac
done
# Bare `nullock` (no command) -> show usage, not "unknown command".
[ $# -gt 0 ] || { _usage; exit 0; }

BASE="http://${HOST}:${PORT}"
# X-Nullock-UI lets a non-browser client pass the CSRF write-gate (same-origin
# Origin is not available from curl); reads ignore it.
UIHDR=(-H "X-Nullock-UI: 1" -H "Origin: ${BASE}")

# get <path>  /  post <path> [json-body]
_get()  { curl -fsS --max-time 30 "${UIHDR[@]}" "${BASE}$1"; }
_post() { local b="${2:-}"; [ -n "$b" ] || b='{}'
          curl -fsS --max-time 60 "${UIHDR[@]}" -H "Content-Type: application/json" \
               -X POST -d "$b" "${BASE}$1"; }

# pretty-print JSON if a tool is available, else raw
_json() { if command -v jq >/dev/null 2>&1; then jq .; else cat; fi; }

_need() { [ -n "${1:-}" ] || { echo "nullock: '$CMD' needs an argument" >&2; exit 2; }; }

# JSON-escape a single string value (for building request bodies safely)
_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

CMD="${1:-}"; shift || true
case "$CMD" in
  status)
    if command -v jq >/dev/null 2>&1; then
      _get /api/snapshot | jq -r '"proxy port \(.bootInfo.port // "?")  ·  control \(.bootInfo.controlPort // "'"$PORT"'")  ·  findings \(.findingsCount // 0)  ·  rows \(.rows|length)  ·  scan-running \(.portScan.running)"'
    else
      _get /api/snapshot >/dev/null && \
        echo "control server reachable at ${BASE}  (install jq for a parsed summary; 'nullock snapshot' prints raw JSON)"
    fi ;;
  snapshot)  _get /api/snapshot | _json ;;
  findings)  _get /api/findings/grouped | _json ;;
  posture)   _get /api/posture | _json ;;
  recon)     _need "${1:-}"; _post /api/recon/dns "{\"domain\":\"$(_esc "$1")\"}" >/dev/null; \
             _post /api/recon/crt "{\"domain\":\"$(_esc "$1")\"}" >/dev/null; \
             echo "recon started for $1 — poll: nullock snapshot | jq .recon" ;;
  whois)     _need "${1:-}"; _post /api/recon/whois "{\"domain\":\"$(_esc "$1")\"}" >/dev/null; \
             echo "whois started for $1 — result: nullock snapshot | jq -r .recon.whois" ;;
  reverse)   _need "${1:-}"; _post /api/recon/reverse "{\"ip\":\"$(_esc "$1")\"}" >/dev/null; \
             echo "reverse DNS started for $1 — result: nullock snapshot | jq '.recon.dns[]|select(.type==\"PTR\")'" ;;
  search)    _need "${1:-}"; curl -fsS --max-time 30 "${UIHDR[@]}" -G \
               --data-urlencode "q=$1" --data "where=both" --data "limit=100" \
               "${BASE}/api/search" | _json ;;
  headers)   _need "${1:-}"; _post /api/headers/audit "{\"url\":\"$(_esc "$1")\"}" | _json ;;
  waf)       _need "${1:-}"; _post /api/waf/detect "{\"url\":\"$(_esc "$1")\"}" | _json ;;
  export)    _need "${1:-}"; case "$1" in
               nmap-xml|sarif|postman|sbom) _get "/api/export/$1" ;;
               *) echo "nullock: export fmt must be nmap-xml|sarif|postman|sbom" >&2; exit 2 ;;
             esac ;;
  report)    _need "${1:-}"; case "$1" in
               json) _get /api/report/json | _json ;;
               html) _post /api/report/build "{}" >/dev/null; _post /api/report/html "{}" ;;
               *) echo "nullock: report must be html|json" >&2; exit 2 ;;
             esac ;;
  pac)       _get /proxy.pac ;;
  raw)       _need "${1:-}"; M="$1"; P="${2:-}"; B="${3:-}"; [ -n "$B" ] || B='{}'; _need "$P"
             if [ "$M" = GET ]; then _get "$P"; else
               curl -fsS --max-time 60 "${UIHDR[@]}" -H "Content-Type: application/json" -X "$M" -d "$B" "${BASE}${P}"; fi ;;
  *) echo "nullock: unknown command '$CMD' (try: nullock --help)" >&2; exit 2 ;;
esac
