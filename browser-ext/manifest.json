{
  "manifest_version": 3,
  "name": "Nullock Companion",
  "version": "0.1.1",
  "description": "Routes browser traffic through a local Nullock proxy and downloads its CA certificate for manual trust setup.",

  "permissions": [
    "proxy",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Nullock Companion"
  },

  "options_page": "options.html"
}
